+// NVFP4 x Q8_0 dot products of one weight row with up to 8 activation rows: the row is decoded once
+struct moe_blk_nvfp4 { uint8_t d[4]; uint8_t qs[32]; };
+struct moe_blk_q8_0  { uint16_t d; int8_t qs[32]; };
+static_assert(sizeof(moe_blk_nvfp4) == 36 && sizeof(moe_blk_q8_0) == 34, "unexpected block sizes");
