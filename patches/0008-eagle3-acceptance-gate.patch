+                        ggml_backend_view_init(src_view);
+                        ggml_backend_view_init(dst_view);
+                        ggml_backend_tensor_copy_async(backend, backend, src_view, dst_view);
+                    }
+                }
+            }
+            e += n;
+        }
+    }
