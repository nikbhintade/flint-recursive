+#include "moe-host.cuh"
+
+static ggml_moe_host_mailbox * moe_host_mailbox(const ggml_tensor * dst) {
+    int64_t ptr;
+    memcpy(&ptr, dst->op_params, sizeof(ptr));
+    return (ggml_moe_host_mailbox *) (intptr_t) ptr;
+}
+
+// blocks of the current send that are done; the last one publishes the request
+static __device__ unsigned int moe_host_send_blocks_done = 0;
+
+// the mailbox is in host memory: each block makes its writes visible, then the last block to finish publishes the request
+static __global__ void k_moe_host_send(const float * x, const int32_t * ids, const float * w, const int32_t * slot_map, int32_t * slots,
+        ggml_moe_host_mailbox * mb, const int n_embd, const int n_tokens, const int n_used, const int layer, const int zero_slot) {
+    float * mb_x = (float *) (mb + 1);
+    const int i0     = blockIdx.x*blockDim.x + threadIdx.x;
+    const int stride = gridDim.x*blockDim.x;
+    for (int i = i0; i < n_embd*n_tokens; i += stride) {
+        mb_x[i] = x[i];
+    }
+    // an expert must not be read twice for a token, so each rank has its own zero slot
+    for (int i = i0; i < n_used*n_tokens; i += stride) {
+        const int32_t s  = slot_map[ids[i]];
+        const int32_t sl = s >= 0 ? s : zero_slot + i % n_used;
+        slots[i]     = sl;
+        mb->slots[i] = sl;
+        mb->ids[i]   = ids[i];
+        mb->w[i]     = w[i];
+    }
+    __threadfence_system();
+    __syncthreads();
+
+    __shared__ bool last;
+    if (threadIdx.x == 0) {
+        last = atomicAdd(&moe_host_send_blocks_done, 1) == gridDim.x - 1;
+    }
+    __syncthreads();
+    if (last && threadIdx.x == 0) {
+        moe_host_send_blocks_done = 0;
+        mb->layer    = layer;
+        mb->n_tokens = n_tokens;
+        mb->n_used   = n_used;
+        mb->n_embd   = n_embd;
+        __threadfence_system();
+        volatile uint32_t * req = &mb->req;
+        *req = *req + 1;
+    }
+}
+
+static __global__ void k_moe_host_wait(const ggml_moe_host_mailbox * mb) {
+    const volatile uint32_t * req  = &mb->req;
+    const volatile uint32_t * done = &mb->done;
+    const uint32_t target = *req;
+    // about 10 s, then fail instead of hanging if the host stops answering
+    for (int64_t i = 0; *done != target; ++i) {
+        if (i > (int64_t) 40*1000*1000) {
+            __trap();
+        }
+        __nanosleep(256);
+    }
+    __threadfence_system();
+}
+
+static __global__ void k_moe_host_add(const float * a, float * dst, const ggml_moe_host_mailbox * mb, const int n_embd, const int n) {
+    const volatile float * out = (const volatile float *) (mb + 1) + (int64_t) n_embd*GGML_MOE_HOST_MAX_TOKENS;
+    for (int i = blockIdx.x*blockDim.x + threadIdx.x; i < n; i += gridDim.x*blockDim.x) {
+        dst[i] = a[i] + out[i];
+    }
+}
+
+static int moe_host_blocks(int64_t n) {
+    return (int) std::min<int64_t>((n + 1023)/1024, 64);
+}
+
+void ggml_cuda_op_moe_host_send(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x   = dst->src[0];
+    const ggml_tensor * ids = dst->src[1];
+    const ggml_tensor * w   = dst->src[2];
+    const ggml_tensor * map = dst->src[3];
+    k_moe_host_send<<<moe_host_blocks(ggml_nelements(x)), 1024, 0, ctx.stream()>>>((const float *) x->data, (const int32_t *) ids->data, (const float *) w->data,
+        (const int32_t *) map->data, (int32_t *) dst->data, moe_host_mailbox(dst), (int) x->ne[0], (int) ggml_nrows(x), (int) ids->ne[0],
+        ggml_get_op_params_i32(dst, 2), ggml_get_op_params_i32(dst, 3));
+}
+
+void ggml_cuda_op_moe_host_recv(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * a = dst->src[0];
+    k_moe_host_wait<<<1, 1, 0, ctx.stream()>>>(moe_host_mailbox(dst));
+    k_moe_host_add<<<moe_host_blocks(ggml_nelements(a)), 1024, 0, ctx.stream()>>>((const float *) a->data, (float *) dst->data,
+        moe_host_mailbox(dst), (int) a->ne[0], (int) ggml_nelements(a));
+}
+
+void ggml_cuda_op_moe_host_call(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    int64_t p_fn;
+    int64_t p_ud;
+    memcpy(&p_fn, (const char *) dst->op_params + 0, sizeof(p_fn));
+    memcpy(&p_ud, (const char *) dst->op_params + 8, sizeof(p_ud));
+    const ggml_moe_host_call_t fn = (ggml_moe_host_call_t) (intptr_t) p_fn;
+    fn((void *) (intptr_t) p_ud, ggml_get_op_params_i32(dst, 4), ggml_get_op_params_i32(dst, 5));
+
+    CUDA_CHECK(cudaMemcpyAsync(dst->data, dst->src[0]->data, ggml_nbytes(dst), cudaMemcpyDeviceToDevice, ctx.stream()));
+}
+
+bool ggml_cuda_moe_host_supported(const ggml_tensor * op) {
+    if (op->op == GGML_OP_MOE_HOST_CALL) {
+        return ggml_is_contiguous(op->src[0]);
+    }
+    if (op->op == GGML_OP_MOE_HOST_SEND) {
+        return op->src[0]->type == GGML_TYPE_F32 && op->src[1]->type == GGML_TYPE_I32 && op->src[2]->type == GGML_TYPE_F32 && op->src[3]->type == GGML_TYPE_I32 &&
+            ggml_nrows(op->src[0]) <= GGML_MOE_HOST_MAX_TOKENS && op->src[1]->ne[0] <= GGML_MOE_HOST_MAX_USED;
+    }
+    return op->src[0]->type == GGML_TYPE_F32 && op->type == GGML_TYPE_F32;
+}
