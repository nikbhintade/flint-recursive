+        struct ggml_tensor  * send,
+        struct ggml_moe_host_mailbox * mailbox) {
+    GGML_ASSERT(a->type == GGML_TYPE_F32 && ggml_is_contiguous(a));
+    GGML_ASSERT(send->op == GGML_OP_MOE_HOST_SEND);
+    GGML_ASSERT(ggml_nrows(a) == ggml_nrows(send->src[0]) && a->ne[0] == send->src[0]->ne[0]);
+
+    struct ggml_tensor * result = ggml_dup_tensor(ctx, a);
+
+    const int64_t ptr = (int64_t) (intptr_t) mailbox;
+    memcpy(result->op_params, &ptr, sizeof(ptr));
