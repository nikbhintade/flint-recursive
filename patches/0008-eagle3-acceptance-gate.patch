+    // copy runs of experts of layer il into its staging area
+    // upload == true: the uncached experts the GPU computes, from host memory
+    // upload == false: the cached experts from the cache, and zeros for the experts the CPU computes
+    void stage_runs(int32_t il, ggml_backend_t backend, bool upload) {
+        const layer & l = layers[il];
+        const group & g = groups[l.ig];
+        const int32_t n_expert = g.ref[0]->ne[2];
+        const int32_t * slots  = g.slru.slot_map[il];
+        auto kind = [&](int32_t e) { return slots[e] >= 0 ? 0 : !l.cpu_map.empty() && l.cpu_map[e] != 0 ? 1 : 2; };
