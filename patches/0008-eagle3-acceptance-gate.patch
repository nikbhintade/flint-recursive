+// ggml_moe_host_send
+
+struct ggml_tensor * ggml_moe_host_send(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * ids,
+        struct ggml_tensor  * w,
+        struct ggml_tensor  * slot_map,
+        struct ggml_moe_host_mailbox * mailbox,
+        int32_t               layer,
+        int32_t               zero_slot) {
+    GGML_ASSERT(x != NULL && ids != NULL && w != NULL && slot_map != NULL && mailbox != NULL);
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && ids->type == GGML_TYPE_I32 && w->type == GGML_TYPE_F32);
+    GGML_ASSERT(slot_map->type == GGML_TYPE_I32 && ggml_is_contiguous(slot_map));
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(ids) && ggml_is_contiguous(w));
+    const int64_t n_tokens = ggml_nrows(x);
+    GGML_ASSERT(n_tokens <= GGML_MOE_HOST_MAX_TOKENS && ids->ne[0] <= GGML_MOE_HOST_MAX_USED);
+    GGML_ASSERT(ggml_nrows(ids) == n_tokens && ggml_nelements(w) == ggml_nelements(ids));
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, ids->ne[0], n_tokens);
+
+    const int64_t ptr = (int64_t) (intptr_t) mailbox;
+    memcpy(result->op_params, &ptr, sizeof(ptr));
+    ggml_set_op_params_i32(result, 2, layer);
+    ggml_set_op_params_i32(result, 3, zero_slot);
+
+    result->op     = GGML_OP_MOE_HOST_SEND;
+    result->src[0] = x;
+    result->src[1] = ids;
+    result->src[2] = w;
+    result->src[3] = slot_map;
+
+    return result;
+}
+
+// ggml_moe_host_call
+
+struct ggml_tensor * ggml_moe_host_call(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        ggml_moe_host_call_t  fn,
+        void                * user_data,
+        int32_t               layer,
+        int32_t               mode) {
+    GGML_ASSERT(fn != NULL && ggml_is_contiguous(a));
+
+    struct ggml_tensor * result = ggml_dup_tensor(ctx, a);
+
+    const int64_t p_fn = (int64_t) (intptr_t) fn;
+    const int64_t p_ud = (int64_t) (intptr_t) user_data;
+    memcpy((char *) result->op_params + 0, &p_fn, sizeof(p_fn));
+    memcpy((char *) result->op_params + 8, &p_ud, sizeof(p_ud));
+    ggml_set_op_params_i32(result, 4, layer);
+    ggml_set_op_params_i32(result, 5, mode);
+
+    result->op     = GGML_OP_MOE_HOST_CALL;
+    result->src[0] = a;
+
+    return result;
+}
