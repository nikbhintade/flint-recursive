+            // runs of consecutive experts of one kind that are contiguous at both ends
+            const int k = kind(e);
+            int32_t n = 1;
+            while (e + n < n_expert && kind(e + n) == k && (k != 0 || slots[e + n] == slots[e] + n) && (k != 1 || n < n_expert_used)) {
+                n++;
