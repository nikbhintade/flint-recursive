+#if defined(__AVX2__) && defined(__F16C__) && defined(__FMA__)
+static void moe_dot_nvfp4_q8_0(int n, const void * vx, const void * const * vy, int ny, float * out) {
+    static const int8_t kvalues[16] = { 0, 1, 2, 3, 4, 6, 8, 12, 0, -1, -2, -3, -4, -6, -8, -12 };
+    const moe_blk_nvfp4 * x = (const moe_blk_nvfp4 *) vx;
+    const __m128i values = _mm_loadu_si128((const __m128i *) kvalues);
+    const __m128i m4b    = _mm_set1_epi8(0x0f);
