+static float moe_ue4m3_lut[256]; // UE4M3 scale * 0.5, the convention of the int8 FP4 values below
+
+static void moe_init_ue4m3_lut() {
+    for (int x = 0; x < 256; ++x) {
+        const int exp = (x >> 3) & 0xF;
+        const int man = x & 0x7;
+        float raw = exp == 0 ? ldexpf((float) man, -9) : ldexpf(1.0f + man/8.0f, exp - 7);
+        if (x == 0 || x == 0x7F) {
+            raw = 0.0f;
+        }
+        moe_ue4m3_lut[x] = raw*0.5f;
+    }
