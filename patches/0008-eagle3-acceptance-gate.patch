+            l.cpu_map[unc[i].second] = g.zero_slot;
+        }
+        ggml_backend_tensor_set_async(devices[g.id].backend, l.dev_cpu_map, l.cpu_map.data(), 0, ggml_nbytes(l.dev_cpu_map));
+    }
