diff --git a/src/llama-moe-cache.cpp b/src/llama-moe-cache.cpp
index 4d3596b..cc8c7d1 100644
--- a/src/llama-moe-cache.cpp
+++ b/src/llama-moe-cache.cpp
@@ -4,14 +4,218 @@
 #include "llama-model.h"
 
 #include "ggml-cpp.h"
+#include "ggml-cpu.h"
 
 #include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
 #include <stdexcept>
+#include <thread>
 #include <unordered_map>
 #include <vector>
 
+#if defined(__x86_64__) || defined(_M_X64)
+#include <immintrin.h>
+#define MOE_CPU_PAUSE() _mm_pause()
+#else
+#define MOE_CPU_PAUSE() std::this_thread::yield()
+#endif
+
 namespace {
 
+// computes the experts of one layer that are not in the cache, for a few tokens, while the GPU computes the others
+// a job has three phases: gate and up rows, then swiglu and quantization, then down rows
+class moe_cpu_pool {
+public:
+    struct expert {
+        int32_t token;
+        const uint8_t * gate;
+        const uint8_t * up;
+        const uint8_t * down;
+        float s_gate;
+        float s_up;
+        float s_down;
+        float weight;
+    };
+
+    moe_cpu_pool(int n_threads, ggml_type type, int64_t n_embd, int64_t n_ff) : n_embd(n_embd), n_ff(n_ff) {
+        const auto * traits = ggml_get_type_traits_cpu(type);
+        vec_dot   = traits->vec_dot;
+        vdt       = traits->vec_dot_type;
+        from_vdt  = ggml_get_type_traits_cpu(vdt)->from_float;
+        row_embd  = ggml_row_size(type, n_embd);
+        row_ff    = ggml_row_size(type, n_ff);
+        row_x     = ggml_row_size(vdt, n_embd);
+        row_h     = ggml_row_size(vdt, n_ff);
+        xq.resize(max_tokens*row_x);
+        gu.resize(max_experts*2*n_ff);
+        hq.resize(max_experts*row_h);
+        for (int i = 0; i < n_threads; ++i) {
+            workers.emplace_back([this] { work(); });
+        }
+    }
+
+    ~moe_cpu_pool() {
+        stop = true;
+        for (auto & t : workers) {
+            t.join();
+        }
+    }
+
+    // x and out are F32 [n_embd, n_tokens]
+    void submit(const expert * ex, int n, const float * x, int n_tokens, float * out) {
+        GGML_ASSERT(n <= max_experts && n_tokens <= max_tokens);
+        // retire the previous job before its counters are reset
+        valid = false;
+        while (n_active.load() > 0) {
+            MOE_CPU_PAUSE();
+        }
+        // group the experts by token
+        n_ex = 0;
+        for (int t = 0; t < n_tokens; ++t) {
+            tok_begin[t] = n_ex;
+            for (int k = 0; k < n; ++k) {
+                if (ex[k].token == t) {
+                    experts[n_ex++] = ex[k];
+                }
+            }
+            tok_end[t] = n_ex;
+            if (tok_end[t] > tok_begin[t]) {
+                from_vdt(x + t*n_embd, xq.data() + t*row_x, n_embd);
+            }
+        }
+        dst = out;
+        if (n == 0) {
+            std::fill(out, out + n_tokens*n_embd, 0.0f);
+        }
+        n_items[0] = n*2*(n_ff/chunk);
+        n_items[1] = n;
+        n_items[2] = n > 0 ? n_tokens*(n_embd/chunk) : 0;
+        for (int p = 0; p < 3; ++p) {
+            claimed[p] = 0;
+            done[p]    = 0;
+        }
+        valid = true;
+        gen++;
+    }
+
+    // the calling thread helps, then waits for the end of the job
+    void wait() {
+        run();
+        while (done[2].load() < n_items[2]) {
+            MOE_CPU_PAUSE();
+        }
+    }
+
+private:
+    static constexpr int max_tokens  = GGML_MOE_HOST_MAX_TOKENS;
+    static constexpr int max_experts = GGML_MOE_HOST_MAX_TOKENS*GGML_MOE_HOST_MAX_USED;
+    static constexpr int chunk       = 32; // rows per work item
+
+    void run() {
+        n_active++;
+        if (valid) {
