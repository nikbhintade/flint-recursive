{
  "providers": {
    "flint-local": {
      "baseUrl": "http://127.0.0.1:8080/v1",
      "api": "openai-completions",
      "apiKey": "local",
      "models": [
        {
          "id": "flint",
          "name": "Flint (local)",
          "reasoning": true,
          "input": [
            "text"
          ],
          "contextWindow": 65536,
